# Shopzy Microservices E-Commerce Platform
# Environment Variables Template

# Service Configuration
SERVICE_NAME=api-gateway
SERVICE_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration - Each service has its own database
DATABASE_URL=postgresql://shopzy:shopzy@localhost/product_db
DATABASE_POOL_SIZE=20
DATABASE_POOL_MAX_OVERFLOW=10

# Service Discovery URLs - For service-to-service communication
PRODUCT_SERVICE_URL=http://product-service:8001
INVENTORY_SERVICE_URL=http://inventory-service:8002
CUSTOMER_SERVICE_URL=http://customer-service:8003
ORDER_SERVICE_URL=http://order-service:8004
PAYMENT_SERVICE_URL=http://payment-service:8005
NOTIFICATION_SERVICE_URL=http://notification-service:8006

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Message Broker Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Payment Service Configuration
PAYMENT_SUCCESS_RATE=0.95
PAYMENT_PROCESSING_DELAY_MS=1000

# Notification Service Configuration
NOTIFICATION_LOG_ONLY=true

# Security Configuration
# JWT_SECRET=your-secret-key-here
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database Initialization
POSTGRES_USER=shopzy
POSTGRES_PASSWORD=shopzy
POSTGRES_DB=shopzy

# Logging Configuration
LOG_FORMAT=json
LOG_FILE=shopzy.log

# API Configuration
API_RATE_LIMIT=1000
API_TIMEOUT=30

# Monitoring
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# Database Migration
AUTO_MIGRATE=true
ALEMBIC_DIR=alembic

# Event Configuration
EVENT_RETRY_COUNT=3
EVENT_RETRY_DELAY_MS=1000

# Pagination Defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_EXTENSIONS=.jpg,.jpeg,.png,.pdf